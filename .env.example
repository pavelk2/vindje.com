# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys (this repo is public).

OPENROUTER_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PORT=8000

# Only needed for outgoing email: subscribe confirmations (app.py) and the
# nightly saved-search digest (digest.py, issue #28)
RESEND_API_KEY=
RESEND_FROM_EMAIL="vindje.com <alerts@vindje.com>"
SITE_ORIGIN=http://localhost:8000
